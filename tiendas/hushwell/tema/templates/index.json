    "faq": {
      "type": "hw-faq",
      "settings": {},
      "blocks": {
        "pregunta-1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Will it work for my snoring?",
            "respuesta": "<p>It's designed for people who snore because their mouth falls open during sleep. If your snoring comes from another cause, it may help less. Loud snoring with pauses in breathing or gasping can be a sign of sleep apnea — please talk to your doctor.</p>"
          }
        },
        "pregunta-2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Will it fit me?",
            "respuesta": "<p>One size fits most adults. The hook-and-loop closure adjusts so you can make it as snug or relaxed as you like.</p>"
          }
        },
        "pregunta-3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "Is it comfortable to sleep in?",
            "respuesta": "<p>It's made from soft, lightweight, breathable fabric. Most people need a night or two to get used to it — start slightly loose and adjust from there.</p>"
          }
        },
        "pregunta-4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "How do I clean it?",
            "respuesta": "<p>Hand wash in cool water with mild soap and let it air dry. Avoid the dryer so it keeps its stretch.</p>"
          }
        },
        "pregunta-5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "What if it's not for me?",
            "respuesta": "<p>Sleep on it for 30 nights. If you're not happy, contact us and we'll make it right.</p>"
          }
        }
      },
